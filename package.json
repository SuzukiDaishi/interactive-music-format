{
  "name": "interactive-music-format",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/iam-pack",
    "packages/iam-player",
    "apps/daw"
  ],
  "scripts": {
    "build:engine": "node scripts/build-engine.mjs",
    "build:packages": "npm run build -w packages/iam-pack && npm run build -w packages/iam-player",
    "build:daw": "npm run build -w apps/daw",
    "build": "npm run build:packages && npm run build:daw",
    "test": "npm run build:packages && node --test tests/*.test.mjs",
    "demo": "npm run build:packages && node examples/make-demo.mjs",
    "demo:wclap": "npm run build:packages && node examples/wclap-demo.mjs",
    "dev": "npm run build:packages && npm run dev -w apps/daw"
  }
}
